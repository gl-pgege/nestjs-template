generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/secondary-client"
}

datasource db {
  provider = "postgresql"
  url      = env("SECONDARY_DATABASE_URL")
}

model Analytics {
  id        String   @id @default(cuid())
  event     String
  userId    String?  @map("user_id")
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("analytics")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   String?
  timestamp DateTime @default(now())

  @@map("logs")
}
